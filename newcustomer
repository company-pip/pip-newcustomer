        <input type="text" id="sheetUrlInput" placeholder="https://script.google.com/macros/s/xxx/exec" value="${escapeHtml(settings.sheetWebhookUrl)}">
      </div>
      <div class="field" style="display:flex;align-items:center;gap:8px;">
        <input type="checkbox" id="sheetSyncToggle" style="width:auto;" ${settings.sheetSyncEnabled?'checked':''}>
        <label style="margin:0;">啟用自動同步</label>
      </div>
      <div style="display:flex;gap:8px;">
        <button class="primary-btn" id="saveSheetBtn">儲存設定</button>
        <button class="refresh-btn" id="testSheetBtn">測試連線</button>
      </div>
    </div>
  `;

  document.getElementById('settingsLogoutBtn').addEventListener('click', ()=>{ adminUnlocked=false; switchTab('form'); });
  document.getElementById('saveAdminPwdBtn').addEventListener('click', async ()=>{
    const val = document.getElementById('newAdminPwd').value.trim();
    if(!val){ alert('請輸入新密碼'); return; }
    await saveSetting('adminPassword', val);
    showToast('密碼已更新'); document.getElementById('newAdminPwd').value='';
  });
  document.getElementById('addSalespersonBtn').addEventListener('click', async ()=>{
    const nameInput = document.getElementById('newSalespersonName');
    const name = nameInput.value.trim();
    if(!name) return;
    if(settings.salespeople.includes(name)){ alert('此姓名已存在'); return; }
    await saveSetting('salespeople', [...settings.salespeople, name]);
    renderSettings();
  });
  document.getElementById('saveSheetBtn').addEventListener('click', async ()=>{
    const url = document.getElementById('sheetUrlInput').value.trim();
    const enabled = document.getElementById('sheetSyncToggle').checked;
    await saveSetting('sheetWebhookUrl', url);
    await saveSetting('sheetSyncEnabled', enabled);
    showToast('已儲存 Google 表單設定');
  });
  document.getElementById('testSheetBtn').addEventListener('click', async ()=>{
    const url = document.getElementById('sheetUrlInput').value.trim();
    if(!url){ alert('請先輸入網址'); return; }
    try{
      await fetch(url, { method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'},
        body: JSON.stringify({ salesperson:'測試', date: todayStr(), store:'測試店家', ordered:true, orderAmount:100, orderType:'零星', noOrderNote:'', products:'測試產品', notes:'這是測試資料', hasPhoto:false }) });
      showToast('已送出測試資料,請至 Google Sheet 確認');
    }catch(e){ console.error(e); alert('連線失敗,請確認網址是否正確、Apps Script 是否已部署為「所有人」可存取'); }
  });

  renderSalespeopleRows();
  renderStoreRows();
}
function renderSalespeopleRows(){
  const wrap = document.getElementById('salespeopleList');
  wrap.innerHTML = settings.salespeople.length ? settings.salespeople.map(name=>`
    <div class="sp-row">
      <input type="text" class="sp-name" value="${escapeHtml(name)}" style="flex:1.4;min-width:110px;">
      <button class="refresh-btn sp-save" data-name="${escapeHtml(name)}">儲存姓名</button>
      <button class="refresh-btn sp-reset" data-name="${escapeHtml(name)}">重設密碼</button>
      <button class="logout-btn sp-del" data-name="${escapeHtml(name)}">刪除</button>
    </div>
  `).join('') : '<div class="empty">尚無業務人員</div>';

  wrap.querySelectorAll('.sp-save').forEach(btn=>{
    btn.addEventListener('click', async (e)=>{
      const row = e.target.closest('.sp-row');
      const oldName = e.target.dataset.name;
      const newName = row.querySelector('.sp-name').value.trim();
      if(!newName){ alert('姓名不可為空'); return; }
      await renameSalesperson(oldName, newName);
      showToast('已儲存'); renderSettings();
    });
  });
  wrap.querySelectorAll('.sp-reset').forEach(btn=>{
    btn.addEventListener('click', async (e)=>{
      const name = e.target.dataset.name;
      const pins = {...settings.personPins}; pins[name] = '0000';
      await saveSetting('personPins', pins);
      showToast(`已將「${name}」的密碼重設為 0000`);
    });
  });
  wrap.querySelectorAll('.sp-del').forEach(btn=>{
    btn.addEventListener('click', async (e)=>{
      const name = e.target.dataset.name;
      if(!confirm(`確定要刪除業務「${name}」嗎?(歷史紀錄不會被刪除)`)) return;
      await saveSetting('salespeople', settings.salespeople.filter(n=>n!==name));
      const pins = {...settings.personPins}; delete pins[name];
      await saveSetting('personPins', pins);
      renderSettings();
    });
  });
}
async function renameSalesperson(oldName, newName){
  const list = settings.salespeople.map(n=> n===oldName ? newName : n);
  await saveSetting('salespeople', list);
  if(oldName !== newName){
    const pins = {...settings.personPins};
    if(pins[oldName] !== undefined){ pins[newName] = pins[oldName]; delete pins[oldName]; }
    await saveSetting('personPins', pins);
    const toUpdate = allVisits.filter(v=>v.salesperson===oldName);
    for(const v of toUpdate){ await updateVisitRecord(v, { salesperson:newName }); }
    allVisits = await fetchAllVisits();
  }
}
function renderStoreRows(){
  const wrap = document.getElementById('storeListWrap');
  wrap.innerHTML = `
    <div class="field">
      <label>選擇業務員</label>
      <select id="storeFilterPerson">
        <option value="">請選擇</option>
        ${settings.salespeople.map(s=>`<option value="${escapeHtml(s)}" ${s===storeMgmtPerson?'selected':''}>${escapeHtml(s)}</option>`).join('')}
      </select>
    </div>
    <div id="storeRowsWrap"></div>
  `;
  document.getElementById('storeFilterPerson').addEventListener('change', (e)=>{
    storeMgmtPerson = e.target.value; renderStoreRowsList();
  });
  renderStoreRowsList();

  function renderStoreRowsList(){
    const listWrap = document.getElementById('storeRowsWrap');
    if(!storeMgmtPerson){ listWrap.innerHTML = '<div class="empty">請先選擇業務員</div>'; return; }
    const stores = uniqueSorted(allVisits.filter(v=>v.salesperson===storeMgmtPerson).map(v=>v.store));
    listWrap.innerHTML = stores.length ? stores.map(s=>`
      <div class="store-row">
        <input type="text" class="store-name" value="${escapeHtml(s)}">
        <button class="refresh-btn store-save" data-old="${escapeHtml(s)}">更新</button>
      </div>
    `).join('') : '<div class="empty">此業務員尚無店家紀錄</div>';
    listWrap.querySelectorAll('.store-save').forEach(btn=>{
      btn.addEventListener('click', async (e)=>{
        const oldName = e.target.dataset.old;
        const row = e.target.closest('.store-row');
        const newName = row.querySelector('.store-name').value.trim();
        if(!newName || newName===oldName) return;
        const toUpdate = allVisits.filter(v=>v.salesperson===storeMgmtPerson && v.store===oldName);
        for(const v of toUpdate){ await updateVisitRecord(v, { store:newName }); }
        allVisits = await fetchAllVisits();
        showToast('店家名稱已更新'); renderSettings();
      });
    });
  }
}

// ====== init ======
(async function init(){
  document.getElementById('main').innerHTML = '<div class="empty">載入資料中...</div>';
  await loadSettings();
  allVisits = await fetchAllVisits();
  renderForm();
})();
</script>
</body>
</html>
