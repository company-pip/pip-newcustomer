async function saveVisit(record, photoDataUrl){
  const suffix = Date.now() + '-' + Math.random().toString(36).slice(2,8);
  const id = STORE_KEY_PREFIX + suffix;
  if(photoDataUrl){
    const photoKey = PHOTO_KEY_PREFIX + suffix;
