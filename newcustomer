function updateStoreOptions(name){
  const sel = document.getElementById('fStoreSelect');
  if(!name){ sel.innerHTML = '<option value="">請先選擇業務姓名</option>'; return; }
  const stores = storesForSalesperson(name);
  sel.innerHTML = '<option value="">請選擇店家</option>'
    + stores.map(s=>`<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('')
    + '<option value="__new__">+ 新增店家(輸入新名稱)</option>';
}
async function handleSubmit(){
  const salesperson = document.getElementById('fSalesperson').value;
  const date = document.getElementById('fDate').value;
  const storeSelectVal = document.getElementById('fStoreSelect').value;
  const storeNewVal = document.getElementById('fStoreNew').value.trim();
  const store = storeSelectVal === '__new__' ? storeNewVal : storeSelectVal;
  const zipCode = document.getElementById('fZipCode').value.trim();
  const region = document.getElementById('fRegion').value.trim();
  const products = document.getElementById('fProducts').value.trim();
  const notes = document.getElementById('fNotes').value.trim();

  clearFormErrors();
  const errors = [];
  if(!salesperson){ errors.push('業務姓名'); markFieldError('fSalesperson'); }
  if(!date){ errors.push('拜訪日期'); markFieldError('fDate'); }
  if(!store){ errors.push('店家名稱'); markFieldError(storeSelectVal==='__new__' ? 'fStoreNew' : 'fStoreSelect'); }
  if(!pendingPhotoDataUrl){ errors.push('現場照片'); markFieldError('fPhoto'); }
  if(formOrdered === null){ errors.push('本次拜訪後是否成功進貨'); markFieldError('btnYes'); markFieldError('btnNo'); }

  let orderAmount=null, orderType=null, noOrderNote=null;
  if(formOrdered === true){
    const amtRaw = document.getElementById('fOrderAmount').value.trim();
    const amt = Number(amtRaw.replace(/[^0-9.]/g,''));
    if(!amt || amt<=0){ errors.push('進貨金額'); markFieldError('fOrderAmount'); }
    else orderAmount = amt;
    if(!formOrderType){ errors.push('進貨類型(切口/零星)'); markFieldError('btnTypeCut'); markFieldError('btnTypeSporadic'); }
    else orderType = formOrderType;
  } else if(formOrdered === false){
    noOrderNote = document.getElementById('fNoOrderNote').value.trim();
    if(!noOrderNote){ errors.push('未進貨原因說明'); markFieldError('fNoOrderNote'); }
    else orderType = null;
  }

  if(errors.length){ showFormErrors(errors); return; }

  const record = { salesperson, date, store, zipCode, region, ordered:formOrdered, orderAmount, orderType, noOrderNote, products, notes, createdAt:new Date().toISOString() };

  const btn = document.getElementById('submitBtn');
  btn.disabled=true; btn.textContent='送出中...';
  try{
    const saved = await saveVisit(record, pendingPhotoDataUrl);
    allVisits.unshift(saved);
    myLastSalesperson = salesperson;
    syncToSheet(saved);
    showToast('已送出拜訪回報');
    formOrdered=null; formOrderType=null; pendingPhotoDataUrl=null;
    renderForm();
  }catch(e){
    console.error(e);
    showFormErrors(['送出失敗,請檢查網路後重試']);
    btn.disabled=false; btn.textContent='送出回報';
  }
}
function markFieldError(id){
  const el = document.getElementById(id);
  if(el) el.classList.add('input-error');
}
function clearFormErrors(){
  document.querySelectorAll('#main .input-error').forEach(el=>el.classList.remove('input-error'));
  const banner = document.getElementById('formErrorBanner');
  if(banner){ banner.style.display='none'; banner.innerHTML=''; }
}
function showFormErrors(messages){
  const banner = document.getElementById('formErrorBanner');
  if(!banner) return;
  banner.innerHTML = '請完成以下必填欄位:<br>' + messages.map(m=>'· '+escapeHtml(m)).join('<br>');
  banner.style.display = 'block';
  banner.scrollIntoView({ behavior:'smooth', block:'start' });
}

