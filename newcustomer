<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>新客拜訪回報系統</title>
<style>
  :root{
    --ink:#16241F; --paper:#F4F6F2; --card:#FFFFFF;
    --primary:#2F6B4F; --primary-dark:#1F4D38; --primary-light:#E4F0E7;
    --warn:#B8452D; --warn-light:#FBE9E4; --line:#DCE3DC; --muted:#5C6B62;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang TC","Microsoft JhengHei",sans-serif;-webkit-font-smoothing:antialiased;}
  .app{max-width:640px;margin:0 auto;min-height:100vh;background:var(--paper);}
  header{padding:20px 20px 14px;border-bottom:1px solid var(--line);background:var(--card);position:sticky;top:0;z-index:10;}
  header h1{font-family:Georgia,"Iowan Old Style","Noto Serif TC",serif;font-size:21px;margin:0 0 2px;color:var(--primary-dark);}
  header p{margin:0;font-size:12px;color:var(--muted);}
  nav.tabs{display:flex;gap:2px;padding:10px 10px 0;background:var(--card);}
  nav.tabs button{flex:1;padding:9px 0;border:none;background:transparent;font-size:12.5px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;cursor:pointer;}
  nav.tabs button.active{color:var(--primary-dark);border-bottom-color:var(--primary);}
  main{padding:16px 20px 60px;}
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:14px;}
  label{display:block;font-size:13px;font-weight:600;color:var(--ink);margin-bottom:6px;}
  .req{color:var(--warn);}
  input[type=text], input[type=date], input[type=password], input[type=file], select, textarea{
    width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;font-size:15px;background:#fff;color:var(--ink);font-family:inherit;
  }
  input:focus, select:focus, textarea:focus{outline:2px solid var(--primary);outline-offset:1px;}
  .field{margin-bottom:16px;}
  textarea{resize:vertical;min-height:60px;}
  .toggle-row{display:flex;gap:10px;}
  .toggle-btn{flex:1;padding:12px 0;border-radius:8px;border:1px solid var(--line);background:#fff;font-size:15px;font-weight:600;color:var(--muted);cursor:pointer;}
  .toggle-btn.yes.active{background:var(--primary-light);border-color:var(--primary);color:var(--primary-dark);}
  .toggle-btn.no.active{background:var(--warn-light);border-color:var(--warn);color:var(--warn);}
  .toggle-btn.type.active{background:var(--primary-light);border-color:var(--primary);color:var(--primary-dark);}
  .submit-btn, .primary-btn{width:100%;padding:14px 0;border:none;border-radius:8px;background:var(--primary);color:#fff;font-size:16px;font-weight:700;cursor:pointer;}
  .submit-btn:disabled{opacity:0.6;}
  .toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--primary-dark);color:#fff;padding:12px 20px;border-radius:30px;font-size:14px;box-shadow:0 6px 18px rgba(0,0,0,0.2);z-index:50;}
  .stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;}
  .stat-box{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 10px;text-align:center;}
  .stat-box .num{font-family:Georgia,serif;font-size:19px;font-weight:700;color:var(--primary-dark);}
  .stat-box .lbl{font-size:10.5px;color:var(--muted);margin-top:2px;}
  .section-title{font-size:14px;font-weight:700;margin:20px 0 8px;color:var(--ink);display:flex;align-items:center;gap:6px;}
  .section-title .dot{width:7px;height:7px;border-radius:50%;background:var(--primary);display:inline-block;}
  .flag-row{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border:1px solid var(--warn);background:var(--warn-light);border-radius:8px;margin-bottom:8px;gap:10px;}
  .flag-row .store{font-weight:700;font-size:14px;}
  .flag-row .meta{font-size:11.5px;color:var(--muted);margin-top:2px;}
  .flag-row .streak{font-size:12px;font-weight:700;color:var(--warn);white-space:nowrap;}
  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  th,td{text-align:left;padding:7px 5px;border-bottom:1px solid var(--line);}
  th{color:var(--muted);font-weight:600;font-size:11px;}
  .badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;}
  .badge.ok{background:var(--primary-light);color:var(--primary-dark);}
  .badge.no{background:var(--warn-light);color:var(--warn);}
  .empty{text-align:center;color:var(--muted);font-size:13px;padding:30px 10px;}
  .note{font-size:11.5px;color:var(--muted);margin-top:4px;line-height:1.5;}
  .refresh-btn{background:none;border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-size:12px;color:var(--muted);cursor:pointer;white-space:nowrap;}
  select.month-select{width:auto;display:inline-block;}
  .lock-wrap{text-align:center;padding:36px 10px;}
  .lock-wrap .icon{font-size:32px;margin-bottom:8px;}
  .lock-wrap input{max-width:220px;margin:12px auto;text-align:center;}
  .logout-btn{background:none;border:none;color:var(--warn);font-size:12px;cursor:pointer;text-decoration:underline;padding:0;white-space:nowrap;}
  .top-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;}
  .sp-row, .store-row{display:flex;gap:6px;align-items:center;margin-bottom:8px;flex-wrap:wrap;}
  .sp-row input, .store-row input{padding:8px 10px;font-size:13px;}
  .input-error{border-color:var(--warn) !important;background:#FFF6F4 !important;}
  button.input-error{background:#FFF6F4 !important;}
  .field-error{color:var(--warn);font-size:12px;margin-top:6px;font-weight:600;}
  .error-banner{background:var(--warn-light);border:1px solid var(--warn);color:var(--warn);padding:10px 12px;border-radius:8px;font-size:13px;margin-bottom:14px;font-weight:600;line-height:1.7;}
</style>
</head>
<body>
<div class="app">
  <header>
    <h1>新客拜訪回報系統</h1>
    <p>新客開發追蹤 · 資料提供給營業部統計追蹤,請如實填寫</p>
  </header>
  <nav class="tabs">
    <button id="tabFormBtn" class="active">填寫紀錄</button>
    <button id="tabMineBtn">我的成效</button>
    <button id="tabAdminBtn">後台統計</button>
    <button id="tabSettingsBtn">設定</button>
  </nav>
  <main id="main"></main>
</div>
<script>
// ====== 設定常數 ======
const DEFAULT_SALESPEOPLE = ['張田裕','劉自強','楊承舜','顏廷樨','林恩霆','陳峰毓','李靜宜','黃敬凱','范振軒'];
const STORE_KEY_PREFIX = 'visit:';
const PHOTO_KEY_PREFIX = 'photo:';

// ====== 全域狀態 ======
let allVisits = [];
let settings = { adminPassword:'sales2026', salespeople:[...DEFAULT_SALESPEOPLE], personPins:{}, sheetWebhookUrl:'', sheetSyncEnabled:false };
let formOrdered = null;
let formOrderType = null;
let pendingPhotoDataUrl = null;
let myLastSalesperson = '';
let adminUnlocked = false;
let adminSelectedPerson = '';
let mineSelectedName = '';
let mineUnlocked = false;
let monthState = { mine:'' };
let storeMgmtPerson = '';
let flaggedScopeVisits = {};

// ====== settings storage ======
async function loadSettings(){
  const keys = ['adminPassword','salespeople','personPins','sheetWebhookUrl','sheetSyncEnabled'];
  for(const k of keys){
    try{
      const r = await window.storage.get('settings:'+k, true);
      if(r && r.value !== undefined) settings[k] = JSON.parse(r.value);
    }catch(e){ /* key not set yet, keep default */ }
  }
}
async function saveSetting(key, value){
  settings[key] = value;
  try{ await window.storage.set('settings:'+key, JSON.stringify(value), true); }
  catch(e){ console.error('saveSetting failed', e); }
}

// ====== visit storage ======
async function fetchAllVisits(){
  try{
    const listRes = await window.storage.list(STORE_KEY_PREFIX, true);
    const keys = (listRes && listRes.keys) ? listRes.keys : [];
    const values = await Promise.all(keys.map(async k=>{
      try{
        const r = await window.storage.get(k, true);
        if(!r) return null;
        const parsed = JSON.parse(r.value);
        parsed._key = k;
        return parsed;
      }catch(e){ return null; }
    }));
    return values.filter(Boolean).sort((a,b)=> new Date(b.date) - new Date(a.date));
  }catch(e){ console.error('fetchAllVisits error', e); return []; }
}
async function saveVisit(record, photoDataUrl){
  const suffix = Date.now() + '-' + Math.random().toString(36).slice(2,8);
  const id = STORE_KEY_PREFIX + suffix;
  if(photoDataUrl){
    const photoKey = PHOTO_KEY_PREFIX + suffix;
    try{
      await window.storage.set(photoKey, photoDataUrl, true);
      record.hasPhoto = true; record.photoKey = photoKey;
    }catch(e){ console.error('photo save failed', e); record.hasPhoto = false; record.photoKey = null; }
  } else { record.hasPhoto = false; record.photoKey = null; }
  const res = await window.storage.set(id, JSON.stringify(record), true);
  if(!res) throw new Error('storage set failed');
  record._key = id;
  return record;
}
async function updateVisitRecord(v, patch){
  const updated = {...v, ...patch};
  delete updated._key;
  try{ await window.storage.set(v._key, JSON.stringify(updated), true); }catch(e){ console.error(e); }
}

// ====== Google Sheet 同步(選填) ======
function syncToSheet(record){
  if(!settings.sheetSyncEnabled || !settings.sheetWebhookUrl) return;
  fetch(settings.sheetWebhookUrl, {
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({
      salesperson: record.salesperson, date: record.date, store: record.store,
      ordered: record.ordered, orderAmount: record.orderAmount || '', orderType: record.orderType || '',
      noOrderNote: record.noOrderNote || '', products: record.products || '', notes: record.notes || '',
      hasPhoto: !!record.hasPhoto
    })
  }).catch(e=>console.warn('sheet sync failed (non-blocking)', e));
}

// ====== utils ======
function todayStr(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function monthOf(dateStr){ return dateStr.slice(0,7); }
function uniqueSorted(arr){ return [...new Set(arr)].sort(); }
function escapeHtml(s){ return (s||'').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function getReasonText(v){ return v.noOrderNote || v.reason || ''; }
function lastNMonths(n){
  const arr=[]; const d=new Date(); d.setDate(1);
  for(let i=0;i<n;i++){ arr.unshift(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')); d.setMonth(d.getMonth()-1); }
  return arr;
}
function storesForSalesperson(name){ return uniqueSorted(allVisits.filter(v=>v.salesperson===name).map(v=>v.store)); }
function monthToIndex(m){ const parts = m.split('-').map(Number); return parts[0]*12 + parts[1]; }

function buildStoreMonthMap(visits){
  const map = {};
  visits.forEach(v=>{
    const m = monthOf(v.date);
    if(!map[v.store]) map[v.store] = { months:{}, lastVisit:v.date, lastReason:getReasonText(v), lastSalesperson:v.salesperson };
    const entry = map[v.store];
    if(!entry.months[m]) entry.months[m] = { ordered:false };
    if(v.ordered) entry.months[m].ordered = true;
    if(new Date(v.date) >= new Date(entry.lastVisit)){ entry.lastVisit=v.date; entry.lastReason=getReasonText(v); entry.lastSalesperson=v.salesperson; }
  });
  return map;
}
function computeStreaks(map){
  const results = [];
  Object.entries(map).forEach(([store, data])=>{
    const months = Object.keys(data.months).sort();
    // walk backward from most recent month, collecting a trailing run of not-ordered months
    const trailing = [];
    for(let i=months.length-1;i>=0;i--){
      if(data.months[months[i]].ordered) break;
      trailing.unshift(months[i]);
    }
    if(trailing.length >= 2){
      let consecutive = true;
      for(let i=1;i<trailing.length;i++){
        if(monthToIndex(trailing[i]) - monthToIndex(trailing[i-1]) !== 1){ consecutive = false; break; }
      }
      results.push({ store, count: trailing.length, consecutive, lastVisit:data.lastVisit, lastReason:data.lastReason, lastSalesperson:data.lastSalesperson });
    }
  });
  return results.sort((a,b)=> b.count - a.count);
}
function newStoreCountsByMonths(visits, monthsList){
  const firstMonth = {};
  visits.forEach(v=>{ const m = monthOf(v.date); if(!firstMonth[v.store] || m < firstMonth[v.store]) firstMonth[v.store] = m; });
  return monthsList.map(m => Object.values(firstMonth).filter(fm=>fm===m).length);
}
function rangeSummary(visits, monthsList){
  const filtered = visits.filter(v=> monthsList.includes(monthOf(v.date)));
  return {
    visitCount: filtered.length,
    storeCount: uniqueSorted(filtered.map(v=>v.store)).length,
    orderedStoreCount: new Set(filtered.filter(v=>v.ordered).map(v=>v.store)).size,
    filtered
  };
}
function storeRowsForMonths(visits, monthsList, showSalesperson){
  const filtered = visits.filter(v=>monthsList.includes(monthOf(v.date))).slice().sort((a,b)=> new Date(a.date)-new Date(b.date));
  const map = {};
  filtered.forEach(v=>{
    const key = v.store + (showSalesperson ? ('||'+v.salesperson) : '');
    if(!map[key]) map[key] = { store:v.store, salesperson:v.salesperson, count:0, ordered:false, lastReason:'', photoKey:null };
    map[key].count++;
    if(v.ordered) map[key].ordered = true;
    if(!v.ordered) map[key].lastReason = getReasonText(v) || map[key].lastReason;
    if(v.hasPhoto && v.photoKey) map[key].photoKey = v.photoKey;
  });
  return Object.values(map).sort((a,b)=> b.count - a.count);
}
function lineChartSVG(labels, values){
  const w=600,h=180,padL=30,padR=14,padT=18,padB=26;
  const maxV = Math.max(1, ...values);
  const stepX = (w-padL-padR)/Math.max(1, labels.length-1);
  const points = values.map((v,i)=>{
    const x = padL + i*stepX;
    const y = padT + (h-padT-padB) * (1 - v/maxV);
    return [x,y];
  });
  const pathD = points.map((p,i)=> (i===0?'M':'L')+p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
  const dots = points.map((p,i)=>`<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="3.5" fill="#1F4D38"></circle><text x="${p[0].toFixed(1)}" y="${(p[1]-8).toFixed(1)}" font-size="10" text-anchor="middle" fill="#1F4D38">${values[i]}</text>`).join('');
  const xLabels = labels.map((l,i)=>`<text x="${points[i][0].toFixed(1)}" y="${h-8}" font-size="10" text-anchor="middle" fill="#5C6B62">${l}</text>`).join('');
  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%;height:auto;display:block;" xmlns="http://www.w3.org/2000/svg">
    <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${h-padB}" stroke="#DCE3DC"/>
    <line x1="${padL}" y1="${h-padB}" x2="${w-padR}" y2="${h-padB}" stroke="#DCE3DC"/>
    <path d="${pathD}" fill="none" stroke="#2F6B4F" stroke-width="2.5"/>
    ${dots}${xLabels}
  </svg>`;
}
function detailTableHTML(rows, showSalesperson){
  if(!rows.length) return '<div class="empty">尚無資料</div>';
  return `<table>
    <thead><tr>
      <th>店家</th>${showSalesperson?'<th>業務</th>':''}<th>拜訪次數</th><th>狀態</th><th>未進貨原因</th><th>照片</th>
    </tr></thead>
    <tbody>
      ${rows.map(r=>`
        <tr>
          <td>${escapeHtml(r.store)}</td>
          ${showSalesperson?`<td>${escapeHtml(r.salesperson)}</td>`:''}
          <td>${r.count}</td>
          <td>${r.ordered?'<span class="badge ok">有進貨</span>':'<span class="badge no">未進貨</span>'}</td>
          <td>${escapeHtml(r.ordered?'-':(r.lastReason||'-'))}</td>
          <td>${r.photoKey?`<button class="refresh-btn view-photo-btn" data-key="${r.photoKey}">查看</button>`:'-'}</td>
        </tr>
      `).join('')}
    </tbody>
  </table>`;
}
function bindPhotoButtons(){
  document.querySelectorAll('.view-photo-btn').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const key = btn.dataset.key;
      const orig = btn.textContent; btn.textContent = '...';
      try{ const r = await window.storage.get(key, true); if(r) openPhotoModal(r.value); }
      catch(e){ alert('照片讀取失敗'); }
      btn.textContent = orig;
    });
  });
}
function openPhotoModal(dataUrl){
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:100;display:flex;align-items:center;justify-content:center;padding:24px;';
  overlay.innerHTML = `<img src="${dataUrl}" style="max-width:100%;max-height:100%;border-radius:8px;">`;
  overlay.addEventListener('click', ()=>overlay.remove());
  document.body.appendChild(overlay);
}
function resizeImageFile(file){
  return new Promise((resolve, reject)=>{
    const reader = new FileReader();
    reader.onload = (e)=>{
      const img = new Image();
      img.onload = ()=>{
        const maxDim = 1000;
        let w=img.width, h=img.height;
        if(w>=h && w>maxDim){ h=Math.round(h*maxDim/w); w=maxDim; }
        else if(h>w && h>maxDim){ w=Math.round(w*maxDim/h); h=maxDim; }
        const canvas = document.createElement('canvas');
        canvas.width=w; canvas.height=h;
        canvas.getContext('2d').drawImage(img,0,0,w,h);
        resolve(canvas.toDataURL('image/jpeg', 0.6));
      };
      img.onerror = reject;
      img.src = e.target.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}
function showToast(msg){
  const t = document.createElement('div'); t.className='toast'; t.textContent=msg;
  document.body.appendChild(t); setTimeout(()=>t.remove(), 2200);
}

// ====== 警示區塊(含拜訪紀錄查看) ======
function flaggedHTML(visits, ns, showSalesperson){
  flaggedScopeVisits[ns] = visits;
  const flagged = computeStreaks(buildStoreMonthMap(visits));
  return `
    <div class="section-title"><span class="dot" style="background:var(--warn);"></span>警示:多月拜訪皆未進貨的店家</div>
    <div>
      ${flagged.length ? flagged.map(f=>`
        <div class="flag-row">
          <div>
            <div class="store">${escapeHtml(f.store)}</div>
            <div class="meta">${showSalesperson ? ('業務:'+escapeHtml(f.lastSalesperson)+' · ') : ''}最近拜訪 ${f.lastVisit} · 原因:${escapeHtml(f.lastReason||'未填')}</div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
            <div class="streak">${f.consecutive ? ('連續 '+f.count+' 個月未進貨') : ('近 '+f.count+' 個月拜訪皆未進貨(非連續)')}</div>
            <button class="refresh-btn view-history-btn" data-ns="${ns}" data-store="${escapeHtml(f.store)}">查看紀錄</button>
          </div>
        </div>
      `).join('') : '<div class="empty">目前沒有多月未進貨的店家</div>'}
    </div>
  `;
}
function bindFlaggedButtons(){
  document.querySelectorAll('.view-history-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const ns = btn.dataset.ns, store = btn.dataset.store;
      const visits = flaggedScopeVisits[ns] || [];
      const history = visits.filter(v=>v.store===store).slice().sort((a,b)=> new Date(b.date)-new Date(a.date));
      openHistoryModal(store, history);
    });
  });
}
function openHistoryModal(storeName, records){
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px;';
  overlay.innerHTML = `
    <div style="background:#fff;border-radius:10px;max-width:420px;width:100%;max-height:80vh;overflow:auto;padding:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <div style="font-weight:700;font-size:15px;">${escapeHtml(storeName)} 拜訪紀錄</div>
        <button class="logout-btn" id="closeHistoryModal">關閉</button>
      </div>
      ${records.length ? records.map(r=>`
        <div style="border-bottom:1px solid var(--line);padding:8px 0;font-size:12.5px;">
          <div style="font-weight:600;">${r.date} · ${escapeHtml(r.salesperson)}</div>
          <div style="margin-top:2px;">${r.ordered ? '<span class="badge ok">有進貨</span>' : '<span class="badge no">未進貨</span>'} ${r.ordered ? (r.orderAmount ? ('$'+r.orderAmount+' · '+escapeHtml(r.orderType||'')) : '') : escapeHtml(getReasonText(r))}</div>
        </div>
      `).join('') : '<div class="empty">尚無紀錄</div>'}
    </div>
  `;
  overlay.addEventListener('click', (e)=>{ if(e.target===overlay) overlay.remove(); });
  document.body.appendChild(overlay);
  document.getElementById('closeHistoryModal').addEventListener('click', ()=>overlay.remove());
}

// ====== tabs ======
function switchTab(tab){
  document.getElementById('tabFormBtn').classList.toggle('active', tab==='form');
  document.getElementById('tabMineBtn').classList.toggle('active', tab==='mine');
  document.getElementById('tabAdminBtn').classList.toggle('active', tab==='admin');
  document.getElementById('tabSettingsBtn').classList.toggle('active', tab==='settings');
  if(tab==='form') renderForm();
  else if(tab==='mine') renderMine();
  else if(tab==='admin') renderAdmin();
  else renderSettings();
}
document.getElementById('tabFormBtn').addEventListener('click', ()=>switchTab('form'));
document.getElementById('tabMineBtn').addEventListener('click', ()=>switchTab('mine'));
document.getElementById('tabAdminBtn').addEventListener('click', ()=>switchTab('admin'));
document.getElementById('tabSettingsBtn').addEventListener('click', ()=>switchTab('settings'));

// ====== 填寫紀錄 ======
function renderForm(){
  const main = document.getElementById('main');
  main.innerHTML = `
