function generateTestRecords(n){
  const storeNames = ['全家福雜貨店','松山五金行','大安早餐店','信義超市','中和文具行','板橋水果行','三重機車行','新莊麵包坊','永和飲料店','土城五金材料行','蘆洲小吃部','新店咖啡館','淡水海產店','林口便利商店','桃園五金行','鶯歌陶瓷行','三峽茶行','中壢五金百貨','八德小吃店','龜山早午餐'];
  const reasons = ['評估中(價格因素),對方希望更優惠的批發價','同性質商品他們已進了競品A牌,賣得比我們好','店內庫存還夠,暫不進貨','老闆不在,下次拜訪再談','希望先試用樣品後再決定','資金週轉問題,下個月再評估'];
  const products = ['潔顏乳/洗面乳系列','保養組合','新品試用組','A系列, B系列','季節限定組合',''];
  const people = settings.salespeople.length ? settings.salespeople : DEFAULT_SALESPEOPLE;

  const records = [];
  people.forEach((sp, spIdx)=>{
    const pool = [0,1,2,3].map(k => storeNames[(spIdx*4+k) % storeNames.length]);
    const neverOrderStore = pool[pool.length-1]; // 讓每位業務都有一間「多次拜訪未進貨」的店,方便測試警示功能
    for(let i=0;i<6;i++){
      const store = pool[i % pool.length];
      const monthsAgo = Math.floor(Math.random()*6);
      const d = new Date();
      d.setMonth(d.getMonth()-monthsAgo);
      d.setDate(1 + Math.floor(Math.random()*26));
      const dateStr = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
      const ordered = (store === neverOrderStore) ? false : (Math.random() < 0.6);
      records.push({
        salesperson: sp, date: dateStr, store, ordered,
        orderAmount: ordered ? (Math.floor(Math.random()*20)+3)*1000 : null,
        orderType: ordered ? (Math.random()<0.5 ? '切口' : '零星') : null,
        noOrderNote: ordered ? null : reasons[Math.floor(Math.random()*reasons.length)],
        products: products[Math.floor(Math.random()*products.length)],
        notes: '', hasPhoto:false, photoKey:null,
        createdAt: new Date(dateStr+'T09:00:00').toISOString()
      });
    }
  });
  // 洗牌後取前 n 筆,確保剛好 n 筆且分布隨機
  for(let i=records.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [records[i],records[j]]=[records[j],records[i]]; }
  return records.slice(0, n);
}
