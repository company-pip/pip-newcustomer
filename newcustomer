async function fetchAllVisits(){
  try{
    const listRes = await window.storage.list(STORE_KEY_PREFIX, true);
    const keys = (listRes && listRes.keys) ? listRes.keys : [];
    const values = await Promise.all(keys.map(async k=>{
      try{
        const r = await window.storage.get(k, true);
        if(!r) return null;
        const parsed = JSON.parse(r.value);
        parsed._key = k;
        return parsed;
      }catch(e){ return null; }
    }));
    return values.filter(Boolean).sort((a,b)=> new Date(b.date) - new Date(a.date));
